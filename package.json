{
  "name": "@cycjimmy/swiper-animation",
  "type": "module",
  "version": "7.2.0",
  "description": "Easier way to run animations on swiper.",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/swiper-animation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/swiper-animation.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/swiper-animation/issues"
  },
  "keywords": [
    "swiper",
    "animation"
  ],
  "exports": {
    ".": {
      "import": "./dist/swiper-animation.esm.js",
      "default": "./dist/swiper-animation.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "main": "dist/swiper-animation.esm.js",
  "module": "dist/swiper-animation.esm.js",
  "unpkg": "dist/swiper-animation.umd.min.js",
  "jsdelivr": "dist/swiper-animation.umd.min.js",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "start": "npm run dev",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --color --forceExit --detectOpenHandles --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"*.html\" \"static/**/*.html\"",
    "lint:style:fix": "stylelint \"*.html\" \"static/**/*.html\" --fix",
    "dev": "vite",
    "build": "trash dist && npm run build:esm && npm run build:umd && npm run build:umd:min",
    "build:esm": "vite build --mode esm",
    "build:umd": "vite build --mode umd",
    "build:umd:min": "vite build --mode umd-min",
    "build:deployment": "vite build --mode deployment && node tasks/copyPublishFiles.js",
    "package": "trash .release && npm run build && node tasks/copyFiles.js && node tasks/handlePackageJson.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cycjimmy/awesome-js-funcs": "^4.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@cycjimmy/config-lib": "^3.2.2",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "fs-extra": "^11.3.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "swiper": "^14.4.0",
    "terser": "^5.51.2",
    "trash-cli": "^7.2.0",
    "vite": "^8.3.5"
  }
}
